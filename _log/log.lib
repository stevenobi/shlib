#!/usr/bin/env bash
#
# log.lib
#
# Shell library to provide CONSOLE LOG functionality to Shell Scripts.
#
# To use these functionalities source this library in your shell scripts.
# See help function for more info about the functions and variables provided.
#
#

_LINE="********************************************************************************"
_LIB=$(basename ${0})
_LIB_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
_ECHO=$(which echo)

## set debug and/or tracing globally
declare -x _LOG=false               ## simple debug output
declare -x _LOG_DATE=false          ## include date in log output
declare -x _LOG_INFO=false          ## log INFO messages
declare -x _LOG_SEVERITY=false      ## add severities to log output (see severity_array)

declare -a _LOG_SEVERITIES=("   [INFO]" "  [ERROR]" "[WARNING]" "  [FATAL]")
declare -A _LOG_SEVERITY_NAMES;
_LOG_SEVERITY_NAMES["info"]=0;
_LOG_SEVERITY_NAMES["error"]=1;
_LOG_SEVERITY_NAMES["warning"]=2;
_LOG_SEVERITY_NAMES["fatal"]=3;

## source date.lib and set date (used when _LOG_DATE=true)
[ -a ${_LIB_DIR}/date.lib ] && {
    . ${_LIB_DIR}/date.lib
    _LDATE=${_DATE};
} || {
    _LDATE=$(date)
    echo "${_LDATE}: Date Library ${_LIB_DIR}/date.lib not found. Using Default Date"
}

## main log function
function _log () {
    [ ${#} -gt 0 ] {
        _OUT=""
        if $_LOG_DATE; then _LD=${_LDATE}; _OUT="${LD}"; fi
        if $_LOG_SEVERITY; then
            [[ ${1} == ?(-)+([0-9]) ]] && {
                _LS=${_LOG_SEVERITIES[${1}]};
                shift;
                } || {
                    _LS=""
                }
        _OUT="${_OUT} [${_LS}]"
        fi
    [[ ! -z ${1} ]] && {
        _OUT="${_OUT}: ${1}"
        ${_ECHO} ${_OUT}
        }
    }
}

