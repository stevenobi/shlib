#!/usr/bin/env bash
#
# date.lib
#
# Shell library to provide DATE formats to Shell Scripts.
#
# To use these functionalities source this library in your shell scripts.
# See help function for more info about the functions and variables provided.
#
#

_LIB=$(basename ${0})
_LIB_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

## date for output (put special formats here)

## POSIX date
_DATE_DEFAULT=$(date);


## Log Dates

## (YYYY.MM.DD)
_YYYYMMDD=$(date '+%Y.%m.%d')
## (DD.MM.YYYY)
_DDMMYYYY=$(date '+%d.%m.%Y')

## (YYYY.MM.DD HH24:MI:SS)
_YYYYMMDD_HH24MISS=$(date '+%Y.%m.%d %H:%M:%S')
## (DD.MM.YYYY HH24:MI:SS)
_DDMMYYYY_HH24MISS=$(date '+%d.%m.%Y %H:%M:%S')

## (YYYY-MM-DD)
_YYYY-MM-DD=$(date '+%Y-%m-%d')
## (DD.MM.YYYY)
_DDMMYYYY=$(date '+%d-%m-%Y')

## (YYYY.MM.DD HH24:MI:SS)
_YYYY-MM-DD_HH24MISS=$(date '+%Y-%m-%d %H:%M:%S')
## (DD.MM.YYYY HH24:MI:SS)
_DD-MM-YYYY_HH24MISS=$(date '+%d-%m-%Y %H:%M:%S')

## add nanoseconds (YYYY.MM.DD HH24:MI:SS)
_YYYYMMDD_HH24MISSXS=$(date '+%d.%m.%Y %H:%M:%S.%N')
## add nanoseconds (DD.MM.YYYY HH24:MI:SS)
_DDMMYYYY_HH24MISSXS=$(date '+%Y.%m.%d %H:%M:%S.%N')

## add nanoseconds (YYYY-MM-DD HH24:MI:SS.SX)
_YYYY-MM-DD_HH24MISSXS=$(date '+%d-%m-%Y %H:%M:%S.%N')
## add nanoseconds (DD-MM-YYYY HH24:MI:SS.SX)
_DD-MM-YYYY_HH24MISSXS=$(date '+%Y-%m-%d %H:%M:%S.%N')


## File dates (f.e. to add to backup files)

## Year first (YYYYMMDDHH24MISS)
_FILEDATE=$(echo ${_YYYYMMDD_HH24MISS} | sed -e s/[\ :.]//g)
## Day first (DDMMYYYYHH24MISS)
_FILEDATE2=$(echo ${_DDMMYYYY_HH24MISS} | sed -e s/[\ :.]//g)

## Year first and add nanoseconds (YYYYMMDDHH24MISSXS)
_FILESTAMP=$(echo ${_YYYYMMDD_HH24MISSXS} | sed -e s/[\ :.]//g)
## add nanoseconds
_FILESTAMP2=$(echo ${_DDMMYYYY_HH24MISSXS} | sed -e s/[\ :.]//g)


## Date _DATE as export variable
declare -x _DATE=${_DATE_DEFAULT}
